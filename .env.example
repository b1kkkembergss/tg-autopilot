# ── tg-autopilot / .env.example ─────────────────────────────────────────────
# Скопируй в .env и заполни. .env в .gitignore — не коммить его.

# === Telegram Business Bot ===
# 1. В @BotFather: /newbot → получишь токен
# 2. Потом /mybots → выбрать бота → Bot Settings → включить Secretary Mode
# 3. На своём аккаунте (нужен Premium): Настройки → Telegram for Business
#    → Автоматизация чатов → выбрать этого бота
BOT_TOKEN=1234567:AAEhBOweik6ad9r_QXMENQjcrGbqCr4KG-g

# Прокси, если Telegram/LLM API недоступны напрямую (xray/v2rayN:
# HTTP-inbound 127.0.0.1:10809). Пусто = напрямую.
# Используется TG_PROXY, чтобы не конфликтовать с системным HTTPS_PROXY (socks).
TG_PROXY=http://127.0.0.1:10809

# === LLM ===
LLM_PROVIDER=openai            # openai | anthropic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Прокси для LLM. Пусто = напрямую. Задай, если API провайдера режется по IP
# или доступен только через VPN (тогда укажи тот же адрес, что в TG_PROXY).
LLM_PROXY=
# Лимит токенов ответа. Для reasoning-моделей (deepseek-*, o-серия) нужен запас:
# они тратят бюджет на размышления, и при малом лимите ответ приходит пустым.
LLM_MAX_TOKENS=1600

# === Поведение ===
# Пауза перед ответом, секунды (случайная в диапазоне) — чтобы не палился бот
REPLY_DELAY_MIN=20
REPLY_DELAY_MAX=90
# Максимум сообщений диалога в контексте LLM
HISTORY_LIMIT=40
# Твой профиль — как отвечать
PERSONA_NAME=Кама
PERSONA_AGE=23
PERSONA_STYLE=уверенный, с юмором, слегка дерзкий; пишу коротко, 1-3 предложения; эмодзи почти не использую — максимум один раз в пару сообщений, чаще без них; флиртую с намёками без пошлости, делаю комплименты внешности и уму; диалог держу интересным — подкалываю, вбрасываю короткие истории о себе, задаю вопросы с подвохом, цепляюсь за её детали и возвращаюсь к ним позже; главная цель — реальная встреча: уже на 2-4 сообщении предлагаю конкретику (кофе, прогулка, бар) со временем и местом; на «не сейчас» не давлю, а предлагаю другой день; после согласия закрепляю договорённость и подтверждаю за пару часов; после встречи мягко веду к себе домой — «заскочим ко мне на вино», упоминаю пару деталей у себя (вид из окна, пластинки, кот); интригу держу, инициативу не теряю, отвечаю живо и в тему
# Приветствие новому чату (пусто = не здороваться первым)
FIRST_MESSAGE=Привет! Как проходит твой день?
# Имена собеседниц (через запятую), с которыми работать. Пусто = все чаты, которые ты разрешил в настройках Telegram
TARGET_USERS=
# Имена, с которыми НЕ работать (твои контакты и знакомые)
EXCLUDE_USERS=

# === Отдельный админ-бот ===
# Создай/перевыпусти токен через @BotFather и впиши локально в .env.
# Не публикуй токен и не коммить .env.
ADMIN_BOT_TOKEN=
ADMIN_USER_ID=7166090548
